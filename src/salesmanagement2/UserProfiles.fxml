<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="574.0" prefWidth="739.0" style="-fx-background-color: blue;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salesmanagement2.UserProfilesController">
   <children>
      <Label layoutX="235.0" prefHeight="53.0" prefWidth="264.0" text="USER PROFILES" textFill="#f0f2f1">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <Label layoutX="10.0" layoutY="124.0" prefHeight="17.0" prefWidth="66.0" text="Username" textFill="#fcfafa">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Label layoutX="9.0" layoutY="190.0" prefHeight="17.0" prefWidth="66.0" text="Password" textFill="#fcf7f7">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Label layoutX="1.0" layoutY="249.0" prefHeight="17.0" prefWidth="83.0" text="Account_type" textFill="#f8f6f6">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="9.0" layoutY="298.0" prefHeight="17.0" prefWidth="48.0" text="Gender" textFill="#fcf8f8">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Label layoutX="1.0" layoutY="350.0" prefHeight="17.0" prefWidth="83.0" text="EmailAddress" textFill="#f8f6f6">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="username" layoutX="82.0" layoutY="121.0" prefHeight="25.0" prefWidth="135.0" promptText="Enter username" />
      <RadioButton fx:id="male" layoutX="79.0" layoutY="290.0" mnemonicParsing="false" text="Male" textFill="#fcf7f7">
         <toggleGroup>
            <ToggleGroup fx:id="genderToggleGroup" />
         </toggleGroup>
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </RadioButton>
      <RadioButton fx:id="female" layoutX="80.0" layoutY="309.0" mnemonicParsing="false" text="Female" textFill="#f5efef" toggleGroup="$genderToggleGroup">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></RadioButton>
      <TextField fx:id="email" layoutX="81.0" layoutY="346.0" prefHeight="25.0" prefWidth="141.0" promptText="Enter your email" />
      <PasswordField fx:id="password" layoutX="79.0" layoutY="187.0" prefHeight="25.0" prefWidth="141.0" promptText="Enter your  password" />
      <ComboBox fx:id="account_type" layoutX="89.0" layoutY="245.0" onAction="#handleAccount_typeAction" prefHeight="25.0" prefWidth="126.0" promptText="choose account" />
      <Button fx:id="update" layoutX="15.0" layoutY="476.0" mnemonicParsing="false" onAction="#handleUpdateAction" prefHeight="25.0" prefWidth="66.0" style="-fx-background-color: green;" text="UPDATE" textFill="#f5f5f8">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button fx:id="add" layoutX="162.0" layoutY="419.0" mnemonicParsing="false" onAction="#handleAddAction" style="-fx-background-color: green;" text="ADD" textFill="#fcfafa">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <Button fx:id="remove" layoutX="137.0" layoutY="475.0" mnemonicParsing="false" onAction="#handleRemoveAction" style="-fx-background-color: red;" text="REMOVE" textFill="#f5f4f4">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <Button fx:id="home" layoutX="6.0" layoutY="6.0" mnemonicParsing="false" onAction="#handleHomeAction" prefHeight="69.0" prefWidth="84.0" style="-fx-background-color: WHITE;" text="HOME">
         <graphic>
            <FontAwesomeIcon fill="#7a80e8" iconName="HOME" size="5em" />
         </graphic></Button>
      <TableView fx:id="userTable" layoutX="222.0" layoutY="60.0" onMouseClicked="#handleTableClick" prefHeight="452.0" prefWidth="507.0">
        <columns>
          <TableColumn fx:id="columnusername" prefWidth="120.0" text="username" />
          <TableColumn fx:id="columnpassword" prefWidth="75.0" text="password" />
            <TableColumn fx:id="columnaccount_type" prefWidth="84.0" text="account_type" />
            <TableColumn fx:id="columnGender" prefWidth="91.0" text="Gender" />
            <TableColumn fx:id="columnEmailAddress" prefWidth="136.0" text="EmailAddress" />
        </columns>
      </TableView>
      <Button fx:id="cancel" layoutX="17.0" layoutY="420.0" mnemonicParsing="false" onAction="#handleCancelAction" style="-fx-background-color: red;" text="CANCEL" textFill="#f8f6f6">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
