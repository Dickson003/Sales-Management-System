<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: BLUE;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salesmanagement2.PasswordforgotController">
   <children>
      <Label layoutX="175.0" layoutY="14.0" prefHeight="40.0" prefWidth="250.0" text="FORGOT PASSWORD" textFill="#f5f4f4">
         <font>
            <Font name="System Bold" size="24.0" />
         </font></Label>
      <Label layoutX="14.0" layoutY="103.0" prefHeight="40.0" prefWidth="140.0" text="Username" textFill="#fffdfd">
         <font>
            <Font name="System Bold" size="24.0" />
         </font></Label>
      <Label layoutX="18.0" layoutY="179.0" prefHeight="40.0" prefWidth="150.0" text="New Password" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></Label>
      <Label layoutX="18.0" layoutY="248.0" prefHeight="33.0" prefWidth="161.0" text="Confirm Password" textFill="#fcf9f9">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></Label>
      <TextField fx:id="username" layoutX="187.0" layoutY="103.0" prefHeight="40.0" prefWidth="256.0" promptText="Enter username">
         <font>
            <Font size="18.0" />
         </font></TextField>
      <PasswordField fx:id="password3" layoutX="187.0" layoutY="184.0" prefHeight="33.0" prefWidth="256.0" promptText="Enter your new password">
         <font>
            <Font size="18.0" />
         </font></PasswordField>
      <PasswordField fx:id="passwordc3" layoutX="187.0" layoutY="252.0" prefHeight="25.0" prefWidth="250.0" promptText="Enter your new password">
         <font>
            <Font size="18.0" />
         </font></PasswordField>
      <Button fx:id="CANCEL" layoutX="187.0" layoutY="318.0" mnemonicParsing="false" onAction="#handleCANCELButtonAction" text="CANCEL" textFill="#f20606">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="OK" layoutX="403.0" layoutY="316.0" mnemonicParsing="false" onAction="#handleOKButtonAction" prefHeight="33.0" prefWidth="46.0" text="OK" textFill="#4906d0">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="back" layoutX="14.0" layoutY="364.0" mnemonicParsing="false" onAction="#handleBackAction" prefHeight="33.0" prefWidth="60.0" text="BACK" textFill="#060217">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
