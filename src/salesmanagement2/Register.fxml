<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" accessibleRole="INCREMENT_BUTTON" prefHeight="507.0" prefWidth="628.0" style="-fx-background-color: blue;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salesmanagement2.RegisterController">
   <children>
      <Label layoutX="148.0" prefHeight="49.0" prefWidth="370.0" text="Register New  Account" textFill="#f3f3f5">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="53.0" layoutY="56.0" prefHeight="49.0" prefWidth="135.0" text="Username" textFill="#f8f4f4">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="56.0" layoutY="122.0" prefHeight="49.0" prefWidth="129.0" text="Password" textFill="#f8f8f8">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="username" layoutX="225.0" layoutY="54.0" prefHeight="49.0" prefWidth="216.0" promptText="Enter your username">
         <font>
            <Font size="14.0" />
         </font></TextField>
      <PasswordField fx:id="password" layoutX="225.0" layoutY="122.0" prefHeight="49.0" prefWidth="216.0" promptText="Enter your password">
         <font>
            <Font size="14.0" />
         </font></PasswordField>
      <Button fx:id="ok" layoutX="225.0" layoutY="391.0" mnemonicParsing="false" onAction="#handleOKButtonAction" prefHeight="43.0" prefWidth="47.0" text="OK" textFill="#150aee">
         <font>
            <Font name="Arial Black" size="14.0" />
         </font>
      </Button>
      <Button fx:id="cancel" layoutX="379.0" layoutY="398.0" mnemonicParsing="false" onAction="#handleCancelButtonAction" prefHeight="36.0" prefWidth="71.0" text="CANCEL" textFill="#f20202">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Label layoutX="69.0" layoutY="187.0" prefHeight="36.0" prefWidth="97.0" text="Gender" textFill="#fcf9f9">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <RadioButton fx:id="male" layoutX="225.0" layoutY="178.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="71.0" text="Male" textFill="#fcf8f8">
         <toggleGroup>
            <ToggleGroup fx:id="genderToggleGroup" />
         </toggleGroup>
         <font>
            <Font name="Arial Black" size="12.0" />
         </font></RadioButton>
      <RadioButton fx:id="female" layoutX="225.0" layoutY="201.0" mnemonicParsing="false" prefHeight="27.0" prefWidth="71.0" text="Female" textFill="#fffbfb" toggleGroup="$genderToggleGroup">
         <font>
            <Font name="Arial Black" size="12.0" />
         </font></RadioButton>
      <Label layoutX="48.0" layoutY="239.0" prefHeight="56.0" prefWidth="165.0" text="Email address" textFill="#f2f0f0">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="email" layoutX="225.0" layoutY="252.0" prefHeight="43.0" prefWidth="216.0" promptText="Enter a valid email address">
         <font>
            <Font size="14.0" />
         </font></TextField>
      <Label layoutX="38.0" layoutY="324.0" prefHeight="36.0" prefWidth="158.0" text="Account type" textFill="#fcf9f9">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <ComboBox fx:id="accountType" layoutX="231.0" layoutY="324.0" onAction="#handleaccountTypeButtonAction" prefHeight="36.0" prefWidth="207.0" promptText="Select account type" />
      <Button fx:id="back" layoutX="14.0" layoutY="468.0" mnemonicParsing="false" onAction="#handleBackAction" text="BACK" textFill="#1d1e1e">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
