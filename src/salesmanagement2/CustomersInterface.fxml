<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="514.0" prefWidth="780.0" style="-fx-background-color: blue;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salesmanagement2.CustomersInterfaceController">
   <children>
      <TableView fx:id="productTable" layoutX="6.0" layoutY="90.0" onMouseClicked="#handleProductSelection" prefHeight="402.0" prefWidth="464.0">
         <columns>
            <TableColumn fx:id="productidcolumn" prefWidth="65.0" text="Product_id" />
            <TableColumn fx:id="productNamecolumn" prefWidth="90.0" text="Product_Name" />
            <TableColumn fx:id="descriptioncolumn" prefWidth="168.0" text="Description" />
            <TableColumn fx:id="categorycolumn" prefWidth="72.0" text="Category" />
            <TableColumn fx:id="pricecolumn" prefWidth="64.0" text="Price" />
         </columns>
      </TableView>
      <Label layoutX="131.0" layoutY="7.0" prefHeight="41.0" prefWidth="374.0" text="WELCOME TO BURUDIKA  SHOP!" textFill="#fefeff">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <ListView fx:id="cart" layoutX="483.0" layoutY="108.0" prefHeight="353.0" prefWidth="298.0" />
      <Button layoutX="492.0" layoutY="375.0" mnemonicParsing="false" onAction="#increaseQuantity" style="-fx-background-color: BLUE;" text=" +" textFill="#f2f0f0">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button layoutX="616.0" layoutY="375.0" mnemonicParsing="false" onAction="#decreaseQuantity" prefHeight="25.0" prefWidth="32.0" style="-fx-background-color: BLUE;" text=" -" textFill="#f5f3f3">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button fx:id="removeButton" layoutX="686.0" layoutY="378.0" mnemonicParsing="false" onAction="#removeProductFromCart" style="-fx-background-color: RED;" text="Remove" textFill="#f2eded">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Label layoutX="527.0" layoutY="382.0" prefHeight="17.0" prefWidth="89.0" text="Adjust quantity" textFill="#141414">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Button fx:id="checkout" layoutX="492.0" layoutY="423.0" mnemonicParsing="false" onAction="#handleCheckoutAction" prefHeight="25.0" prefWidth="89.0" style="-fx-background-color: green;" text="CHECK OUT" textFill="#fcf8f8">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Label layoutX="153.0" layoutY="48.0" prefHeight="35.0" prefWidth="247.0" text=" SHOP WITH US." textFill="#fefeff">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Button fx:id="Logout" layoutX="697.0" layoutY="8.0" mnemonicParsing="false" onAction="#handleLogoutAction" prefHeight="48.0" prefWidth="73.0" text="LOGOUT">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
