<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="614.0" prefWidth="774.0" style="-fx-background-color: BLUE;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salesmanagement2.InventoryController">
   <children>
      <Label layoutX="259.0" prefHeight="71.0" prefWidth="389.0" text="PRODUCTS" textFill="#fefffe">
         <font>
            <Font name="Arial Black" size="48.0" />
         </font>
      </Label>
      <Label layoutX="10.0" layoutY="109.0" prefHeight="27.0" prefWidth="88.0" text="Product ID" textFill="#fcf9f9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="10.0" layoutY="147.0" prefHeight="36.0" prefWidth="88.0" text="Product Name" textFill="#fffefe">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="14.0" layoutY="204.0" prefHeight="27.0" prefWidth="80.0" text="Description" textFill="#fcf8f8">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="17.0" layoutY="249.0" prefHeight="36.0" prefWidth="74.0" text="Category" textFill="#f8f6f6">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="17.0" layoutY="307.0" prefHeight="36.0" prefWidth="74.0" text="Price" textFill="#fffbfb">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="17.0" layoutY="362.0" prefHeight="36.0" prefWidth="74.0" text="Stock" textFill="#fff9f9">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="product_id" layoutX="102.0" layoutY="109.0" promptText="Enter Product_id" />
      <TextField fx:id="productName" layoutX="110.0" layoutY="152.0" promptText="Enter Product_Name" />
      <TextField fx:id="description" layoutX="102.0" layoutY="204.0" promptText="Enter Product Description" />
      <TextField fx:id="category" layoutX="102.0" layoutY="260.0" promptText="Enter Product Category" />
      <TextField fx:id="price" layoutX="93.0" layoutY="313.0" promptText="Enter Price of the Product" />
      <TextField fx:id="stock" layoutX="94.0" layoutY="368.0" prefHeight="25.0" prefWidth="165.0" promptText="Input Stock you want to add" />
      <TableView fx:id="productTable" layoutX="264.0" layoutY="71.0" prefHeight="486.0" prefWidth="504.0">
        <columns>
          <TableColumn fx:id="productidcolumn" onEditCommit="#handleEditCommitProductID" prefWidth="65.0" text="Product_id" />
          <TableColumn fx:id="productNamecolumn" onEditCommit="#handleEditCommitProductName" prefWidth="90.0" text="Product_Name" />
            <TableColumn fx:id="descriptioncolumn" onEditCommit="#handleEditCommitDescription" prefWidth="130.0" text="Description" />
            <TableColumn fx:id="categorycolumn" onEditCommit="#handleEditCommitCategory" prefWidth="81.0" text="Category" />
            <TableColumn fx:id="pricecolumn" onEditCommit="#handleEditCommitPrice" prefWidth="69.0" text="Price" />
            <TableColumn fx:id="stockcolumn" onEditCommit="#handleEditCommitStock" prefWidth="49.0" text="Stock" />
        </columns>
      </TableView>
      <Button fx:id="cancel" layoutX="31.0" layoutY="414.0" mnemonicParsing="false" onAction="#handleCancel" prefHeight="45.0" prefWidth="74.0" style="-fx-background-color: RED;" text="CANCEL" textFill="#fff9f9">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="update" layoutX="24.0" layoutY="500.0" mnemonicParsing="false" onAction="#handleUpdate" prefHeight="45.0" prefWidth="80.0" style="-fx-background-color: GREEN;" text="UPDATE" textFill="#ededee">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="add" layoutX="185.0" layoutY="414.0" mnemonicParsing="false" onAction="#handleAdd" prefHeight="45.0" prefWidth="66.0" style="-fx-background-color: GREEN;" text="ADD" textFill="#f5f4f8">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="remove" layoutX="167.0" layoutY="500.0" mnemonicParsing="false" onAction="#handleRemove" prefHeight="45.0" prefWidth="88.0" style="-fx-background-color: RED;" text="REMOVE" textFill="#fcf8f8">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Button>
      <Button fx:id="home" layoutX="10.0" layoutY="575.0" mnemonicParsing="false" onAction="#handleHome" prefHeight="25.0" prefWidth="59.0" text="HOME" textFill="#02171b">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
   </children>
</AnchorPane>
