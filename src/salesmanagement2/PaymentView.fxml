<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="mainAnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: blue;" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="salesmanagement2.PaymentViewController">
    <children>
        <Label layoutX="172.0" layoutY="14.0" prefHeight="40.0" prefWidth="199.0" text="PAYMENT" textFill="#f0f5f1">
            <font>
                <Font name="System Bold" size="36.0" />
            </font>
        </Label>
        <Label fx:id="totalAmountLabel" layoutX="26.0" layoutY="312.0" prefHeight="53.0" prefWidth="191.0" text="Total Amount" textFill="#f8f5f5">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
        <Label fx:id="selectedItemsLabel" layoutX="26.0" layoutY="95.0" prefHeight="184.0" prefWidth="365.0" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
        <Button fx:id="pay" layoutX="548.0" layoutY="328.0" mnemonicParsing="false" onAction="#handlePaymentAction" style="-fx-background-color: GREEN;" text="PAY" textFill="#f5f5f5">
         <font>
            <Font name="System Bold" size="11.0" />
         </font></Button>
        <TextField fx:id="mpesano" layoutX="358.0" layoutY="328.0" prefHeight="21.0" prefWidth="175.0" promptText="m.pesa number you wish to pay with">
            <font>
                <Font size="10.0" />
            </font>
        </TextField>
        <Label layoutX="251.0" layoutY="332.0" prefHeight="17.0" prefWidth="93.0" text="M.pesa Number" textFill="#f5f2f2">
         <font>
            <Font name="System Bold" size="11.0" />
         </font></Label>
        <!-- Dynamic Progress Bar and Label -->
        <!-- You can add them dynamically from the controller -->
        <!-- Dynamic Progress Bar and Label -->
<ProgressBar fx:id="paymentProgressBar" layoutX="50.0" layoutY="100.0" prefWidth="200.0" visible="false" />
<Label fx:id="progressLabel" layoutX="260.0" layoutY="100.0" prefWidth="90.0" text="Waiting..." visible="false" />
      <Button fx:id="back" layoutX="14.0" layoutY="365.0" mnemonicParsing="false" onAction="#handleBackAction" text="BACK">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
    </children>
</AnchorPane>
